# ==============================================================================
# E2 Travel Solutions - Tier-1 Support Specialist AI Console
# Environment Configuration Template
# ==============================================================================

# 1. GEMINI_API_KEY (Required for live Gemini AI generation)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# In AI Studio hosted environments, this is injected automatically from Secrets.
# For local development: copy this file to .env and insert your real key.
# If omitted or empty, the server automatically operates in Offline Knowledge Base mode.
GEMINI_API_KEY="your-gemini-api-key-here"

# 2. GEMINI_MODEL (Optional)
# Default model: gemini-3.8-flash
# Alternative valid models: gemini-3.1-flash-lite, gemini-flash-latest
GEMINI_MODEL="gemini-3.8-flash"

# 3. PORT (Optional)
# The HTTP port for the full-stack Express server.
# Default is 3000.
PORT=3000

# 4. NODE_ENV (Optional)
# Set to 'development' for local Vite HMR middleware mode,
# or 'production' for serving pre-built static assets from /dist.
NODE_ENV="development"

# 5. APP_URL (Optional)
# Base public URL where the application is hosted.
APP_URL="http://localhost:3000"
